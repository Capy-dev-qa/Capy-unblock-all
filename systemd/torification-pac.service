[Unit]
Description=Torification PAC server (browser-agnostic)
After=network.target

[Service]
Type=simple
Environment=TORIFICATION_PAC=%h/.config/torification/proxy.pac
Environment=TORIFICATION_PAC_PORT=18767
# install.sh replaces __TORIFICATION_ROOT__ with the repo path
ExecStart=__TORIFICATION_ROOT__/.venv/bin/python3 __TORIFICATION_ROOT__/scripts/pac_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
